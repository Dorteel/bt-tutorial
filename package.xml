<?xml version="1.0"?>
<package format="3">
  <name>behavior_trees_tutorial</name>
  <version>0.1.0</version>
  <description>Progressive notebook laboratory for behavior trees and ROS 2.</description>
  <maintainer email="maintainers@example.com">Behavior Trees Tutorial contributors</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>python3-setuptools</exec_depend>
  <exec_depend>py_trees</exec_depend>
  <exec_depend>py_trees_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>example_interfaces</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
